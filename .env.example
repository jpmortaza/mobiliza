# MOBILIZA+ - Configurações de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais reais

# Banco de Dados
DB_HOST=localhost
DB_USER=seu_usuario
DB_PASS=sua_senha
DB_NAME=mobiliza
DB_CHARSET=utf8mb4

# Ambiente (development, production)
APP_ENV=development
APP_DEBUG=true

# URLs (deixe em branco para detecção automática)
SITE_URL=
ADMIN_URL=

# Segurança
SESSION_LIFETIME=7200
CSRF_TOKEN_LENGTH=32

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW=60

# Email (para futuras implementações)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@mobiliza.com
MAIL_FROM_NAME="Mobiliza+"

# Integrações (opcionais)
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=
WHATSAPP_API_TOKEN=

# Upload
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
